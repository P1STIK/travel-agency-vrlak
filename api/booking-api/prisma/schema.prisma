generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  PAID
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id             String        @id @default(cuid())
  code           String        @unique
  departureId    String
  departure      Departure?    @relation(fields: [departureId], references: [id])
  tourSlug       String?
  email          String
  seats          Int
  unitPriceCents Int
  totalAmount    Int
  currency       String        @default("EUR")
  status         BookingStatus @default(PENDING)
  paymentRef     String?
  passengers     Passenger[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Passenger {
  id               String    @id @default(cuid())
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId        String
  firstName        String
  lastName         String
  birthDate        DateTime?
  nationalId       String?
  street           String?
  city             String?
  zip              String?
  phone            String?
  email            String?
  insuranceDocPath String?
}

model Tour {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  teaser       String?
  description  String?
  currency     String      @default("EUR")
  heroImage    String?
  thumbImage   String?
  duration     String?
  pickupPoints String[]    @default([])
  gallery      String[]    @default([])
  category     String?
  tags         String[]    @default([])
  extras       Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  departures   Departure[]
}

model Departure {
  id             String    @id @default(cuid())
  date           DateTime
  returnDate     DateTime?
  time           String?
  timeTo         String?
  unitPriceCents Int
  capacity       Int       @default(50)
  tourId         String
  tour           Tour      @relation(fields: [tourId], references: [id])
  bookings       Booking[]
  driverId       String?
  driver         Driver?   @relation(fields: [driverId], references: [id])
  busId          String?
  bus            Bus?      @relation(fields: [busId], references: [id])

  @@index([tourId])
}

model Driver {
  id             String          @id @default(cuid())
  name           String          @unique
  phone          String?
  color          String          @default("#6b7280")
  departures     Departure[]
  scheduledRides ScheduledRide[]
  staffUser      StaffUser?
}

model Bus {
  id             String          @id @default(cuid())
  name           String
  licensePlate   String          @unique
  color          String
  imageUrl       String?
  departures     Departure[]
  scheduledRides ScheduledRide[]
}

enum StaffRole {
  ADMIN
  DRIVER
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole
  driverId     String?   @unique
  driver       Driver?   @relation(fields: [driverId], references: [id])
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ScheduledRide {
  id        String   @id @default(cuid())
  date      DateTime
  time      String?
  timeTo    String?
  label     String
  note      String?
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  busId     String?
  bus       Bus?     @relation(fields: [busId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}